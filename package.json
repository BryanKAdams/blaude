{
  "name": "blaude",
  "version": "0.2.0",
  "description": "Local-first gateway that lets Claude Code drive a local model over the Anthropic wire protocol, escalating to Claude only when you ask.",
  "type": "module",
  "bin": {
    "blaude": "./bin/blaude.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "serve": "node bin/blaude.mjs serve",
    "doctor": "node bin/blaude.mjs doctor",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "bin",
    "src",
    "blaude.config.example.json",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanKAdams/blaude.git"
  },
  "homepage": "https://github.com/BryanKAdams/blaude#readme",
  "bugs": {
    "url": "https://github.com/BryanKAdams/blaude/issues"
  },
  "author": "Bryan Adams",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ollama",
    "mlx",
    "local-llm",
    "gateway",
    "proxy"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
